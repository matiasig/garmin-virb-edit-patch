<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <configSections>
        <sectionGroup name="userSettings" type="System.Configuration.UserSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089">
            <section name="Virb.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" allowExeDefinition="MachineToLocalUser" requirePermission="false"/>
        </sectionGroup>
    </configSections>
    <userSettings>
        <Virb.Properties.Settings>
            <setting name="UserLanguage" serializeAs="String">
                <value />
            </setting>
            <setting name="VirbVideoPath" serializeAs="String">
                <value />
            </setting>
            <setting name="ShowEditHints" serializeAs="String">
                <value>True</value>
            </setting>
            <setting name="ShowAutoSaveHint" serializeAs="String">
                <value>True</value>
            </setting>
            <setting name="LastTrackPath" serializeAs="String">
                <value />
            </setting>
            <setting name="LastMusicPath" serializeAs="String">
                <value />
            </setting>
            <setting name="LastVideoPath" serializeAs="String">
                <value />
            </setting>
            <setting name="ShowSaveAsNewTemplateTooltip" serializeAs="String">
                <value>True</value>
            </setting>
            <setting name="ShowChangeTemplateWarning" serializeAs="String">
                <value>True</value>
            </setting>
            <setting name="ShowDeleteCustomTemplateWarning" serializeAs="String">
                <value>True</value>
            </setting>
            <setting name="ShowOptimizeClipsPrompt" serializeAs="String">
                <value>True</value>
            </setting>
            <setting name="UpdateRequired" serializeAs="String">
                <value>True</value>
            </setting>
            <setting name="VideoUploadProvider" serializeAs="String">
                <value>eYoutube</value>
            </setting>
            <setting name="LastValidatedExportVideoPath" serializeAs="String">
                <value />
            </setting>
            <setting name="ExportPngOverlays" serializeAs="String">
                <value>False</value>
            </setting>
            <setting name="PhotoUploadProvider" serializeAs="String">
                <value>eFacebook</value>
            </setting>
            <setting name="VirbPhotoPath" serializeAs="String">
                <value />
            </setting>
            <setting name="FirstRunSince3x" serializeAs="String">
                <value>True</value>
            </setting>
            <setting name="ShowVirbDetectionAlert" serializeAs="String">
                <value>True</value>
            </setting>
            <setting name="HideOverlaysWithoutGmetrix" serializeAs="String">
                <value>True</value>
            </setting>
            <setting name="PreferredEncoder" serializeAs="String">
                <value>eFfmpeg</value>
            </setting>
            <setting name="LastDatabaseBackupPath" serializeAs="String">
                <value />
            </setting>
            <setting name="Pressure" serializeAs="String">
                <value>eBars</value>
            </setting>
            <setting name="ShowOptimizeClipsPromptOnShutdown" serializeAs="String">
                <value>True</value>
            </setting>
            <setting name="ShowOptimizeClipsPromptForMediaCommand" serializeAs="String">
                <value>True</value>
            </setting>
            <setting name="BrandingOption" serializeAs="String">
                <value>eStart</value>
            </setting>
            <setting name="Distance" serializeAs="String">
                <value />
            </setting>
            <setting name="Temperature" serializeAs="String">
                <value />
            </setting>
            <setting name="Elevation" serializeAs="String">
                <value />
            </setting>
            <setting name="WeightUnit" serializeAs="String">
                <value />
            </setting>
            <setting name="LiquidVolumeUnit" serializeAs="String">
                <value />
            </setting>
            <setting name="PreferredDecoder" serializeAs="String">
                <value>eMediaFoundation</value>
            </setting>
            <setting name="MasterPlaybackVolume" serializeAs="String">
                <value>1</value>
            </setting>
            <setting name="ShowIndividualGaugeTransformLostWarning" serializeAs="String">
                <value>True</value>
            </setting>
            <setting name="ShowGroupGaugeTransformLostWarning" serializeAs="String">
                <value>True</value>
            </setting>
            <setting name="LastDecoderAutoDetectVersion" serializeAs="String">
                <value>0.0</value>
            </setting>
            <setting name="LastEncoderAutoDetectVersion" serializeAs="String">
                <value>0.0</value>
            </setting>
            <setting name="TechnologyAutoDetectIsRunning" serializeAs="String">
                <value>False</value>
            </setting>
            <setting name="ShowSphericalPlayerFirstTimeHint" serializeAs="String">
                <value>True</value>
            </setting>
            <setting name="PlaybackQuality" serializeAs="String">
                <value>2147483647</value>
            </setting>
            <setting name="Quality" serializeAs="String">
                <value>2</value>
            </setting>
            <setting name="LastWatchExportedVideoPath" serializeAs="String">
                <value />
            </setting>
            <setting name="SuccessfulExport" serializeAs="String">
                <value>False</value>
            </setting>
            <setting name="BrandingThemeOption" serializeAs="String">
                <value>eLight</value>
            </setting>
            <setting name="PreferredMap" serializeAs="String">
                <value>eGoogle</value>
            </setting>
        </Virb.Properties.Settings>
    </userSettings>

    <system.runtime.caching>
        <memoryCache>
            <namedCaches>
                <add name="default" cacheMemoryLimitMegabytes="0" physicalMemoryLimitPercentage="0" pollingInterval="00:02:00"/>
                <add name="ImageConverterCache" cacheMemoryLimitMegabytes="1" physicalMemoryLimitPercentage="0" pollingInterval="00:02:00"/>
            </namedCaches>
        </memoryCache>
    </system.runtime.caching>

    <!-- Use Awesomium in a different folder to prevent conflicts between the Awesomium and 
         CefSharp dependencies.  Ideally both would be in their own folders, but CefSharp doesn't
         work property like this -->
    <runtime>
        <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
            <probing privatePath="Awesomium"/>
        </assemblyBinding>
    </runtime>

    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6.1"/>
    </startup>
</configuration>
